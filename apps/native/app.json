{
  "expo": {
    "scheme": "elector",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "web": {
      "bundler": "metro"
    },
    "name": "elector",
    "slug": "elector",
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Elector needs camera access to scan your Aadhaar QR code."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Elector needs photo library access to read your Aadhaar QR from an image."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
