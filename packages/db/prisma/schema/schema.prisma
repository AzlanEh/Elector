generator client {
  provider = "prisma-client"
  output   = "../generated"
  moduleFormat = "esm"
  runtime = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  aadhaarHash  String   @unique // hashed Aadhaar UID — never stored in plain text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
